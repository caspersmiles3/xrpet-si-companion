{
  "name": "xrpet-si-companion",
  "version": "1.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/app.js --bundle --outfile=public/app.js --format=iife --target=es2020",
    "start": "node server.js",
    "dev": "npm run build && node --watch server.js",
    "mobile:sync": "npm run build && npx cap sync",
    "android": "npm run mobile:sync && npx cap open android",
    "ios": "npm run mobile:sync && npx cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@gemwallet/api": "^3.7.0",
    "cheerio": "^1.0.0",
    "express": "^5.1.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "esbuild": "^0.25.0"
  }
}
